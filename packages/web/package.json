{
  "name": "@rushood/web",
  "private": true,
  "version": "0.0.0",
  "description": "RUSHOOD web app (Next.js + wagmi)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "next lint",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --import tsx --test test/*.test.ts",
    "test:connected": "playwright test -c playwright.connected.config.ts",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@rushood/verifier": "*",
    "@tanstack/react-query": "^5.101.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.55.2",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
