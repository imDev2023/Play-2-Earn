# Robinhood Chain RPC endpoints (Alchemy recommended for production)
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY
ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployer key - NEVER commit a real key. Used only for deploy scripts (later tickets).
DEPLOYER_PRIVATE_KEY=

# Address that receives the entire fixed RUSH supply at deployment.
# Required on live networks; defaults to the first local signer for local runs.
DISTRIBUTOR_ADDRESS=

# --- Launch deployment (#26, scripts/deploy-launch.ts) ---------------------
# Several accounts so the launch checklist can use DISTINCT addresses for
# deployer / relayer / player / guardian. Comma-separated; overrides
# DEPLOYER_PRIVATE_KEY. NEVER commit real keys.
TESTNET_PRIVATE_KEYS=

# The relayer's master seed - the crown-jewel secret (spec §8). REQUIRED on any
# public network: without it the deploy would fall back to the committed dev seed
# and every roll would be predictable in advance.
RELAYER_SEED=

# Safe multisig: owns the Timelock, holds community + staking allocations, and
# receives LP trading fees. Required on public networks.
GOVERNANCE_SAFE=
# Beneficiary of the 10% team allocation held by RushoodVesting.
TEAM_BENEFICIARY=
# Account the game authorises to settle bets (defaults to the second signer).
RELAYER_ADDRESS=
# Seconds a queued governance change must wait. Defaults to 2 days.
TIMELOCK_MIN_DELAY=

# Uniswap v3 on the target chain. BOTH are required on a public network - the
# script refuses to guess, since seeding into the wrong contract loses the
# liquidity allocation.
#
# Robinhood Chain MAINNET (4663) has a canonical Uniswap v3; use its published
# position manager and the chain's canonical WETH.
#
# Robinhood Chain TESTNET (46630) does NOT - every mainnet Uniswap address has
# empty code there. Stand one up first and paste the two addresses it prints:
#
#   npx hardhat run scripts/deploy-uniswap-v3.ts --network robinhoodTestnet
#
# That script refuses to run on 4663, so it cannot shadow the canonical deployment.
UNISWAP_POSITION_MANAGER=
WETH_ADDRESS=

# Label baked into the position NFT's SVG by the self-deployed stack. Defaults to ETH.
NATIVE_CURRENCY_LABEL=

# ETH side of the LP seed, in wei. The RUSH side is derived from it at the pinned
# 1e-7 ETH/RUSH price, so a smaller pool opens at the SAME price.
# Defaults: 25 ETH on mainnet, 0.05 ETH on testnet.
LP_ETH_AMOUNT=
# Uniswap fee tier in hundredths of a bip. Defaults to 3000 (0.30%).
LP_FEE_TIER=
# Set to "true" to accept seeding less than the full 25% allocation, leaving the
# remainder outside the LP lock as a visible overhang.
ALLOW_PARTIAL_LP_SEED=

# --- Blockscout verification (scripts/verify-and-publish.ts) ---------------
# Blockscout ignores the key but requires a non-empty one.
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_TESTNET_URL=
BLOCKSCOUT_MAINNET_URL=
