{
  "name": "@rushood/contracts",
  "private": true,
  "version": "0.0.0",
  "description": "RUSHOOD smart contracts (Hardhat)",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc --noEmit",
    "lint": "solhint --config .solhint.json --max-warnings 0 'contracts/**/*.sol'",
    "node": "hardhat node",
    "deploy:skeleton": "hardhat run scripts/deploy-skeleton.ts --network localhost",
    "deploy:launch": "hardhat run scripts/deploy-launch.ts --network localhost",
    "checklist": "hardhat run scripts/launch-checklist.ts --network localhost",
    "verify:publish": "hardhat run scripts/verify-and-publish.ts",
    "relayer": "hardhat run scripts/relayer.ts --network localhost",
    "relayer:service": "tsx scripts/relayer-service.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.9.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v3-periphery": "^1.4.4",
    "hardhat": "^2.22.17",
    "solhint": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@rushood/verifier": "*",
    "ethers": "^6.17.0",
    "tsx": "^4.23.1"
  }
}
